# server/.env.example
#
# 复制成 .env 后改掉这些值：
#   cp .env.example .env
#
# 只有 .env 会被读取，.env.example 本身不会生效。
#
# ── 可移植性说明 ──────────────────────────────────────────
# 本服务端会在多种环境下自动适配，**不需要为环境改代码**：
#
#   * 布局自动识别：原始结构（php/lib/）与平铺结构（htdocs/lib/）都能跑
#   * 配置来源优先级：真实环境变量 > .env > 内置默认值
#   * 目录自动创建：userdata/ 不存在时会自动建
#   * 免 cron：维护任务在请求里概率触发（见 lib/housekeeping.php）
#
# 没有 .env 也能启动，但会用 localhost/root —— 安装器会明确警告。
# ─────────────────────────────────────────────────────────

# ---------------------------------------------------------------- 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lemonlite

# ---------------------------------------------------------------- HTTP
PORT=8080
# 0.0.0.0 才能让手机从局域网访问；放在 Nginx 后面时应改成 127.0.0.1
HOST=0.0.0.0
# 反代后面设为 true，否则日志里的 IP 全是代理的
TRUST_PROXY=false
# CORS 白名单，逗号分隔；留空或 * 表示允许所有（仅开发期合适）
CORS_ORIGIN=*

# ---------------------------------------------------------------- 账号
# token 有效期：
#   never（默认）= 永不过期。客户端只要没卸载、本地 token 还在，就一直有效；
#                 撤销依然随时生效（退出登录 / 踢设备 / 改密码 / 停用账号）。
#   7d / 12h / 30m = 到点失效。每次请求会滑窗续期，经常用就不会掉线。
TOKEN_TTL=never

# 注册要不要邮箱验证码。默认 on。
# 关掉（off）只适合内网/自测 —— 邮箱不是秘密，没有验证谁都能用别人的邮箱开号。
AUTH_REGISTER_CODE=on

# 登录要不要再要一次邮箱验证码（二次验证）。默认 off。
# 打开后：密码对还不够，还要收到邮件验证码才能登录。
# 客户端不写死这个行为，启动时读 /api/auth/config 跟着服务端走。
AUTH_LOGIN_CODE=off
# password_hash 的 bcrypt cost（10 约 60~100ms，够用且不拖慢登录）
BCRYPT_COST=10
# 单用户最多同时保留多少个有效会话（超出踢掉最旧的）；0 = 不限制
MAX_SESSIONS_PER_USER=20

# ---------------------------------------------------------------- 邮件（注册验证码）
#
# 注册需要邮箱验证码，所以这里必须配一个能发信的通道。
# 通道用 MAIL_DRIVER 切，改完重启即可，不需要改代码：
#
#   smtp      自建 Postfix / 企业邮箱 / QQ 邮箱授权码 —— 见下方 SMTP_*
#   resend    Resend（海外最省事，免费额度够小站用）—— RESEND_API_KEY
#   sendgrid  Twilio SendGrid —— SENDGRID_API_KEY
#   aliyun    阿里云邮件推送 DirectMail —— ALIYUN_DM_*（国内送达率最好）
#   console   不发信，只在服务端日志里打印验证码（**仅本地开发**）
#
# 留空或写 console 时，注册接口会直接返回「邮件通道未配置」。
MAIL_DRIVER=console
# 发件地址：必须是通道那边验证过的域名/地址，否则会被拒或被当垃圾邮件
MAIL_FROM=no-reply@example.com
# 收件人看到的发件人名称
MAIL_FROM_NAME=LemonLite

# 验证码本身
MAIL_CODE_LENGTH=6
MAIL_CODE_TTL=600
# 同一邮箱再次索要的冷却（秒）
MAIL_CODE_COOLDOWN=60
# 每小时配额（防轰炸）：单邮箱 / 单 IP
MAIL_CODE_MAX_PER_EMAIL=10
MAIL_CODE_MAX_PER_IP=30
# 单个验证码允许输错的次数，超过要重新获取
MAIL_CODE_MAX_ATTEMPTS=5
# 开发用：把验证码直接放进接口响应的 debugCode 字段（生产务必 false）
MAIL_DEV_ECHO_CODE=false

# ---- 自建 / 兼容 SMTP 的邮箱
SMTP_HOST=
# 465 = 隐式 TLS（SMTP_SECURE=true）；587/25 = 明文 + STARTTLS
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
# QQ/163 这类邮箱这里填的是「授权码」，不是登录密码
SMTP_PASSWORD=
# 自签证书的内网邮件服务器可以设 false
SMTP_REJECT_UNAUTHORIZED=true
SMTP_TIMEOUT_MS=15000

# ---- 第三方：Resend（https://resend.com）
RESEND_API_KEY=

# ---- 第三方：SendGrid（https://sendgrid.com）
SENDGRID_API_KEY=

# ---- 第三方：阿里云邮件推送 DirectMail
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
# 控制台里配置的发信地址，如 no-reply@mail.example.com
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_REGION=cn-hangzhou

# ---------------------------------------------------------------- 市场
# 分段加载每页条数（默认 / 上限）
MARKET_PAGE_SIZE=20
MARKET_MAX_PAGE=50

# ---------------------------------------------------------------- 小程序包
#
# 包文件**不存这台服务器**：数据库里只存完整的外部 URL
#（GitHub Release / Cloudflare R2 / 对象存储 等），客户端直接下载。
# 所以这里没有包目录、也没有包大小上限的配置项。

# ---------------------------------------------------------------- 用户数据
# userdata/<id>/data.json 与 userdata/<id>/avatar.png 的根目录
USERDATA_DIR=userdata
# 头像大小上限（字节）
AVATAR_MAX_BYTES=2097152
# data.json 大小上限（字节）
USERDATA_MAX_BYTES=16777216

# ---------------------------------------------------------------- 管理面板
#
# http://<本机IP>:<端口>/admin
#
# **留空就不启用**（访问 /admin 只会显示一句提示）。这里不要抄示例值 ——
# 面板能改邮件通道，等于能接管所有验证码，口令必须是你自己定的。
ADMIN_PASSWORD=
# 登录态有效期（小时），默认 7 天
ADMIN_SESSION_HOURS=168
