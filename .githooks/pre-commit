#!/bin/sh
# 阻止「凭据 / 构建产物」被提交。
#
# 启用：git config core.hooksPath .githooks
# 说明：本仓库当前在 Android /sdcard（FUSE）上，该文件系统不保留可执行位，
#       因此克隆到普通文件系统后需先执行 `chmod +x .githooks/pre-commit`。
#       临时校验可手动跑：sh .githooks/pre-commit
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

bad=$(printf '%s\n' "$staged" | grep -iE '(^|/)(证书信息\.txt|key\.properties|\.env)$|\.(jks|keystore|p12|apk|aab)$|(^|/)node_modules/|(^|/)\.gradle/|(^|/)build/|(^|/)\.dart_tool/')
if [ -n "$bad" ]; then
  echo "✗ 拒绝提交：以下文件属于凭据或构建产物，不应入库" >&2
  printf '    %s\n' $bad >&2
  echo "  如确认要提交，用 git commit --no-verify 覆盖（不推荐）" >&2
  exit 1
fi

if printf '%s\n' "$staged" | xargs -r grep -lI -- '-----BEGIN [A-Z ]*PRIVATE KEY-----' 2>/dev/null | grep -q .; then
  echo "✗ 拒绝提交：暂存内容里含私钥块" >&2
  exit 1
fi
exit 0
